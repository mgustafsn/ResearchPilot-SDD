# Copy to .env (ignored), supply your own local database credentials.
POSTGRES_USER=researchpilot
POSTGRES_PASSWORD=
POSTGRES_DB=researchpilot_sdd
# URL-encode the password in these URLs; never reuse the original application's DB.
DATABASE_URL=
TEST_DATABASE_URL=
# Set to 1 only when TEST_DATABASE_URL names a disposable researchpilot_sdd_test DB.
ALLOW_TEST_DATABASE_RESET=0

# Optional: generation sends saved question/keywords to OpenAI on explicit action.
# store:false is not zero retention. Manual query controls require no key.
OPENAI_API_KEY=
OPENAI_QUERY_MODEL=gpt-4.1-mini-2025-04-14
